{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Steerholm",
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#4a4dae",
    "light": "#6366f1",
    "dark": "#3b3d8f"
  },
  "appearance": {
    "default": "dark"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/steerholm/steerholm",
        "icon": "github"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install",
      "href": "/getting-started/installation"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "getting-started/introduction",
          "getting-started/installation",
          "getting-started/quickstart"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/add-an-agent",
          "guides/add-a-server",
          "guides/managing-access",
          "guides/troubleshooting"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/control-plane",
          "concepts/architecture",
          "concepts/permissions",
          "concepts/error-codes"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/mcp-endpoint",
          "reference/configuration",
          "reference/policy-format"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/reference/bridge",
      "destination": "/reference/mcp-endpoint"
    }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/steerholm/steerholm"
    }
  }
}
