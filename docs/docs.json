{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Steerholm",
  "colors": {
    "primary": "#4a4dae",
    "light": "#6366f1",
    "dark": "#3b3d8f"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/steerholm/steerholm",
        "icon": "github"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install",
      "href": "/latest/getting-started/installation"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/steerholm/steerholm"
    }
  },
  "navigation": {
    "versions": [
      {
        "version": "v0.1 (latest)",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "latest/getting-started/introduction",
              "latest/getting-started/installation",
              "latest/getting-started/quickstart"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "latest/guides/add-an-agent",
              "latest/guides/add-a-server",
              "latest/guides/managing-access",
              "latest/guides/troubleshooting"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "latest/concepts/control-plane",
              "latest/concepts/architecture",
              "latest/concepts/permissions",
              "latest/concepts/error-codes"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "latest/reference/cli",
              "latest/reference/mcp-endpoint",
              "latest/reference/configuration",
              "latest/reference/policy-format"
            ]
          }
        ],
        "default": true
      }
    ]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/latest/getting-started/introduction",
      "permanent": false
    },
    {
      "source": "/latest",
      "destination": "/latest/getting-started/introduction",
      "permanent": false
    },
    {
      "source": "/v0.1",
      "destination": "/latest/getting-started/introduction",
      "permanent": false
    },
    {
      "source": "/v0.1/:slug*",
      "destination": "/latest/:slug*",
      "permanent": false
    },
    {
      "source": "/getting-started/:slug*",
      "destination": "/latest/getting-started/:slug*",
      "permanent": false
    },
    {
      "source": "/guides/:slug*",
      "destination": "/latest/guides/:slug*",
      "permanent": false
    },
    {
      "source": "/concepts/:slug*",
      "destination": "/latest/concepts/:slug*",
      "permanent": false
    },
    {
      "source": "/reference/:slug*",
      "destination": "/latest/reference/:slug*",
      "permanent": false
    }
  ]
}
